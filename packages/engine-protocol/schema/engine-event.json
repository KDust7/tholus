{
  "$id": "https://uv-wasm.invalid/protocol/0/engine-event.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "log"
        },
        "invocationId": {
          "type": "string"
        },
        "level": {
          "type": "string",
          "enum": [
            "trace",
            "debug",
            "info",
            "warn",
            "error"
          ]
        },
        "message": {
          "type": "string"
        },
        "target": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "level",
        "message"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "phase"
        },
        "invocationId": {
          "type": "string"
        },
        "phase": {
          "type": "string",
          "enum": [
            "resolving",
            "downloading",
            "building",
            "installing",
            "uninstalling",
            "auditing"
          ]
        },
        "state": {
          "type": "string",
          "enum": [
            "start",
            "end"
          ]
        }
      },
      "required": [
        "type",
        "invocationId",
        "phase",
        "state"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "progress"
        },
        "invocationId": {
          "type": "string"
        },
        "progressId": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "download",
            "build",
            "install",
            "checkout"
          ]
        },
        "subject": {
          "type": "string"
        },
        "current": {
          "type": "number",
          "minimum": 0
        },
        "total": {
          "type": "number",
          "minimum": 0
        },
        "unit": {
          "type": "string",
          "enum": [
            "bytes",
            "items"
          ]
        }
      },
      "required": [
        "type",
        "invocationId",
        "progressId",
        "kind",
        "current",
        "unit"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "request"
        },
        "invocationId": {
          "type": "string"
        },
        "method": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "status": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "fromCache": {
          "type": "boolean"
        },
        "bytes": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "type",
        "method",
        "url",
        "fromCache"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "resolution-complete"
        },
        "invocationId": {
          "type": "string"
        },
        "packageCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "durationMs": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "type",
        "invocationId",
        "packageCount",
        "durationMs"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "install-report"
        },
        "invocationId": {
          "type": "string"
        },
        "installed": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "version": {
                "type": "string"
              },
              "source": {
                "type": "string"
              }
            },
            "required": [
              "name"
            ]
          }
        },
        "removed": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "version": {
                "type": "string"
              },
              "source": {
                "type": "string"
              }
            },
            "required": [
              "name"
            ]
          }
        },
        "unchanged": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "type",
        "invocationId",
        "installed",
        "removed",
        "unchanged"
      ]
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "runtime-finalize"
        },
        "invocationId": {
          "type": "string"
        },
        "package": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "version": {
              "type": "string"
            },
            "source": {
              "type": "string"
            }
          },
          "required": [
            "name"
          ]
        },
        "action": {
          "type": "string",
          "enum": [
            "dynlibs",
            "build"
          ]
        },
        "state": {
          "type": "string",
          "enum": [
            "start",
            "end"
          ]
        }
      },
      "required": [
        "type",
        "invocationId",
        "package",
        "action",
        "state"
      ]
    }
  ]
}
