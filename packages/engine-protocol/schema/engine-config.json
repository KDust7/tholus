{
  "$id": "https://tholus.invalid/protocol/0/engine-config.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "fs": {
      "default": {
        "kind": "memory"
      },
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "memory"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "opfs"
            },
            "root": {
              "type": "string"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "delegate"
            }
          },
          "required": [
            "kind"
          ]
        }
      ]
    },
    "cache": {
      "default": {
        "kind": "memory"
      },
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "opfs"
            },
            "scope": {
              "type": "string"
            },
            "abiTag": {
              "type": "string"
            },
            "budgetBytes": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "memory"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "none"
            }
          },
          "required": [
            "kind"
          ]
        }
      ]
    },
    "transport": {
      "default": {
        "kind": "platform"
      },
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "platform"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "fetch"
            },
            "rewriteHead": {
              "type": "boolean"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "libcurl"
            },
            "moduleUrl": {
              "type": "string"
            },
            "wasmUrl": {
              "type": "string"
            },
            "relayUrl": {
              "type": "string"
            },
            "userAgent": {
              "type": "string"
            },
            "maxConnections": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "connectionCache": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "connectionsPerHost": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "kind",
            "moduleUrl",
            "relayUrl"
          ]
        }
      ]
    },
    "index": {
      "default": {},
      "type": "object",
      "properties": {
        "indexUrl": {
          "type": "string"
        },
        "extraIndexUrls": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "indexStrategy": {
          "type": "string",
          "enum": [
            "first-index",
            "unsafe-first-match",
            "unsafe-best-match"
          ]
        },
        "pyodideIndex": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "env": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "cwd": {
      "default": "/work",
      "type": "string"
    },
    "logFilter": {
      "type": "string"
    }
  }
}
