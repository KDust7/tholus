          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "delegate"
            }
          },
          "required": [
            "kind"
          ]
        }
      ]
    },
    "cache": {
      "default": {
        "kind": "memory"
      },
      "oneOf": [
        {
          "type": "object",
          "properties": {
