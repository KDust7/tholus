{
  "name": "@tholus/engine-protocol",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0 OR MIT",
  "description": "Wire contract between the tholus engine worker and its host",
  "keywords": [
    "uv",
    "pip",
    "python",
    "package-manager",
    "resolver",
    "wasm",
    "webassembly",
    "browser",
    "protocol",
    "zod",
    "worker"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KDust7/tholus.git",
    "directory": "packages/engine-protocol"
  },
  "homepage": "https://github.com/KDust7/tholus#readme",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema/*": "./schema/*"
  },
  "files": [
    "dist",
    "schema"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node dist/cli/emit-schema.js",
    "emit-schema": "bun run build",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3"
  }
}
