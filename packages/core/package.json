{
  "name": "@uv-wasm/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0 OR MIT",
  "description": "Embeddable uv engine for the browser",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "assets"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && bun run bundle-worker",
    "bundle-worker": "esbuild dist/worker.js --bundle --format=esm --platform=browser --target=es2022 --outfile=dist/worker.js --allow-overwrite",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@uv-wasm/engine-protocol": "workspace:*",
    "@uv-wasm/transport-fetch": "workspace:*",
    "@uv-wasm/transport-libcurl": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@uv-wasm/mock-engine": "workspace:*",
    "esbuild": "^0.27.2",
    "vitest": "^4.1.10"
  }
}
