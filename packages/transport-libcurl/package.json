{
  "name": "@uv-wasm/transport-libcurl",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0 OR MIT",
  "description": "A uv-wasm transport over a host-supplied libcurl.js, for Wisp relays and a real User-Agent",
  "keywords": [
    "uv",
    "pip",
    "python",
    "package-manager",
    "resolver",
    "wasm",
    "webassembly",
    "browser",
    "libcurl",
    "transport",
    "wisp",
    "proxy"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KDust7/uv-wasm.git",
    "directory": "packages/transport-libcurl"
  },
  "homepage": "https://github.com/KDust7/uv-wasm#readme",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@uv-wasm/engine-protocol": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "libcurl.js": "0.7.4",
    "vitest": "^4.1.10"
  }
}
