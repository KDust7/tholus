{
  "name": "exec-stdin-buffer",
  "summary": "The host hands the invocation its standard input as bytes in the exec message",
  "protocolVersion": "0",
  "steps": [
    {
      "from": "host",
      "message": {
        "type": "init",
        "id": "init-1",
        "protocolVersion": "0",
        "config": {
          "fs": {
            "kind": "memory"
          },
          "cache": {
            "kind": "memory"
          }
        }
      }
    },
    {
      "from": "worker",
      "message": {
        "type": "bootProgress",
        "phase": "compile-start"
      }
    },
    {
      "from": "worker",
      "message": {
        "type": "bootProgress",
        "phase": "compile-done",
        "ms": "$any"
      }
    },
    {
      "from": "worker",
      "message": {
        "type": "bootProgress",
        "phase": "init-start"
      }
    },
    {
      "from": "worker",
      "message": {
        "type": "bootProgress",
        "phase": "ready",
        "ms": "$any"
      }
    },
    {
      "from": "worker",
      "message": {
        "type": "initResult",
        "id": "init-1",
        "outcome": {
          "ok": true,
          "build": {
            "engine": "$any",
            "uv": "$any",
            "protocol": "0"
          }
        }
      }
    },
    {
      "from": "host",
      "message": {
        "type": "exec",
        "invocationId": "inv-1",
        "argv": [
          "pip",
          "compile",
          "-"
        ],
        "stdin": {
          "$text": "anyio\nidna\n"
        }
      }
    },
    {
      "from": "worker",
      "message": {
        "type": "output",
        "invocationId": "inv-1",
        "stream": "stdout",
        "seq": 0,
        "data": {
          "$text": "anyio==4.6.2\nidna==3.10\n"
        }
      }
    },
    {
      "from": "worker",
      "message": {
        "type": "exit",
        "invocationId": "inv-1",
        "code": 0,
        "cancelled": false,
        "durationMs": "$any"
      }
    }
  ]
}
