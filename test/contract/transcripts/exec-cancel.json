{
  "name": "exec-cancel",
  "summary": "A parked invocation is cancelled and reports the cancellation exit code",
  "protocolVersion": "0",
  "steps": [
    {
      "from": "host",
      "message": {
        "type": "init",
        "id": "init-1",
        "protocolVersion": "0",
        "config": {
          "fs": {
            "kind": "memory"
          },
          "cache": {
            "kind": "memory"
          }
        }
      }
    },
    {
      "from": "worker",
      "message": {
        "type": "bootProgress",
        "phase": "compile-start"
      }
    },
    {
      "from": "worker",
      "message": {
        "type": "bootProgress",
        "phase": "compile-done",
        "ms": "$any"
      }
    },
    {
      "from": "worker",
      "message": {
        "type": "bootProgress",
        "phase": "init-start"
      }
    },
    {
      "from": "worker",
      "message": {
        "type": "bootProgress",
        "phase": "ready",
        "ms": "$any"
      }
    },
    {
      "from": "worker",
      "message": {
        "type": "initResult",
        "id": "init-1",
        "outcome": {
          "ok": true,
          "build": {
            "engine": "$any",
            "uv": "$any",
            "protocol": "0"
          }
        }
      }
    },
    {
      "from": "host",
      "message": {
        "type": "exec",
        "invocationId": "inv-1",
        "argv": [
          "pip",
          "install",
          "slow"
        ]
      }
    },
    {
      "from": "worker",
      "message": {
        "type": "output",
        "invocationId": "inv-1",
        "stream": "stderr",
        "seq": 0,
        "data": {
          "$text": "Resolving dependencies\n"
        }
      }
    },
    {
      "from": "host",
      "message": {
        "type": "cancel",
        "invocationId": "inv-1",
        "reason": "user interrupt"
      }
    },
    {
      "from": "worker",
      "message": {
        "type": "exit",
        "invocationId": "inv-1",
        "code": 130,
        "cancelled": true,
        "durationMs": "$any"
      }
    }
  ]
}
