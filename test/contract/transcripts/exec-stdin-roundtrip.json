{
  "name": "exec-stdin-roundtrip",
  "summary": "The engine asks the host for a line and waits for the answer before continuing",
  "protocolVersion": "0",
  "steps": [
    {
      "from": "host",
      "message": {
        "type": "init",
        "id": "init-1",
        "protocolVersion": "0",
        "config": {
          "fs": {
            "kind": "memory"
          },
          "cache": {
            "kind": "memory"
          }
        }
      }
    },
    {
      "from": "worker",
      "message": {
        "type": "bootProgress",
        "phase": "compile-start"
      }
    },
    {
      "from": "worker",
      "message": {
        "type": "bootProgress",
        "phase": "compile-done",
        "ms": "$any"
      }
    },
    {
      "from": "worker",
      "message": {
        "type": "bootProgress",
        "phase": "init-start"
      }
    },
    {
      "from": "worker",
      "message": {
        "type": "bootProgress",
        "phase": "ready",
        "ms": "$any"
      }
    },
    {
      "from": "worker",
      "message": {
        "type": "initResult",
        "id": "init-1",
        "outcome": {
          "ok": true,
          "build": {
            "engine": "$any",
            "uv": "$any",
            "protocol": "0"
          }
        }
      }
    },
    {
      "from": "host",
      "message": {
        "type": "exec",
        "invocationId": "inv-1",
        "argv": [
          "pip",
          "uninstall",
          "rich"
        ],
        "stdin": true
      }
    },
    {
      "from": "worker",
      "message": {
        "type": "output",
        "invocationId": "inv-1",
        "stream": "stderr",
        "seq": 0,
        "data": {
          "$text": "Proceed? [y/n] "
        }
      }
    },
    {
      "from": "worker",
      "message": {
        "type": "stdinRequest",
        "id": "$any",
        "invocationId": "inv-1",
        "echo": true
      }
    },
    {
      "from": "host",
      "message": {
        "type": "stdinResponse",
        "id": "stdin-1",
        "data": "y\n"
      }
    },
    {
      "from": "worker",
      "message": {
        "type": "output",
        "invocationId": "inv-1",
        "stream": "stderr",
        "seq": 1,
        "data": {
          "$text": "Uninstalled 1 package\n"
        }
      }
    },
    {
      "from": "worker",
      "message": {
        "type": "exit",
        "invocationId": "inv-1",
        "code": 0,
        "cancelled": false,
        "durationMs": "$any"
      }
    }
  ]
}
