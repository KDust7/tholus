{
  "name": "exec-stdout-exit",
  "summary": "A successful command streams stdout bytes then reports exit zero",
  "protocolVersion": "0",
  "steps": [
    {
      "from": "host",
      "message": {
        "type": "exec",
        "invocationId": "inv-1",
        "argv": [
          "pip",
          "list"
        ]
      }
    },
    {
      "from": "worker",
      "message": {
        "type": "output",
        "invocationId": "inv-1",
        "stream": "stdout",
        "seq": 0,
        "data": {
          "$text": "rich    13.9.4\n"
        }
      }
    },
    {
      "from": "worker",
      "message": {
        "type": "exit",
        "invocationId": "inv-1",
        "code": 0,
        "cancelled": false,
        "durationMs": "$any"
      }
    }
  ]
}
